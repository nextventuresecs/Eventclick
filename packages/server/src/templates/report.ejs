<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Official Event Verification Report</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800&display=swap');

    /* A4 page setup */
    @page {
      size: A4;
      margin: 18mm 16mm 18mm 16mm;
    }

    :root {
      --color-primary: hsl(220, 25%, 15%);
      --color-primary-ink: hsl(220, 25%, 35%);
      --color-accent: hsl(220, 85%, 55%);
      --color-success: hsl(142, 70%, 29%);
      --color-success-ink: hsl(142, 70%, 98%);
      --color-surface: #ffffff;
      --color-muted: hsl(220, 20%, 64%);
      --color-rule: hsl(220, 20%, 88%);
      --color-danger-ink: hsl(0, 70%, 45%);

      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-display: 'Outfit', sans-serif;

      --space-1: 4px;
      --space-2: 8px;
      --space-3: 12px;
      --space-4: 16px;
      --space-5: 20px;
      --space-6: 24px;
      --space-8: 32px;
      --space-10: 40px;

      --text-xs: 10px;
      --text-sm: 12px;
      --text-base: 13px;
      --text-lg: 15px;
      --text-xl: 18px;
      --text-2xl: 22px;
      --text-3xl: 26px;

      --leading-tight: 1.25;
      --leading-normal: 1.5;
      --leading-relaxed: 1.65;

      --radius: 6px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      background: #ffffff;
      color: var(--color-primary);
      font-family: var(--font-body);
      font-size: var(--text-base);
      line-height: var(--leading-normal);
      -webkit-font-smoothing: antialiased;
    }

    /* Typography */
    h1, h2, h3, h4 {
      font-family: var(--font-display);
      font-weight: 700;
      line-height: var(--leading-tight);
      letter-spacing: -0.01em;
      color: var(--color-primary);
    }

    h1 { font-size: var(--text-3xl); }
    h2 { font-size: var(--text-2xl); }
    h3 { font-size: var(--text-xl); }

    p {
      margin: 0;
    }

    ul, ol {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    /* Layout */
    .page {
      max-width: 210mm;
      margin: 0 auto;
      padding: 6mm 0;
    }

    /* Header */
    .doc-header {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: var(--space-6);
      align-items: start;
      padding-bottom: var(--space-5);
      border-bottom: 1.5px solid var(--color-primary);
      margin-bottom: var(--space-6);
      page-break-inside: avoid;
    }

    .doc-meta {
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--color-muted);
      font-weight: 600;
      margin-bottom: var(--space-1);
    }

    .doc-title {
      margin-bottom: var(--space-2);
    }

    .doc-subtitle {
      color: var(--color-primary-ink);
      max-width: 52ch;
    }

    .doc-controls {
      min-width: 26mm;
      text-align: right;
      font-size: var(--text-xs);
      line-height: 1.8;
      color: var(--color-primary-ink);
    }

    .doc-controls strong {
      color: var(--color-primary);
    }

    /* Summary */
    .summary {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-4);
      margin-bottom: var(--space-8);
      page-break-inside: avoid;
    }

    .summary-card {
      border: 1px solid var(--color-rule);
      border-radius: var(--radius);
      padding: var(--space-4) var(--space-5);
      background: var(--color-surface);
    }

    .summary-card .label {
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-muted);
      font-weight: 600;
      margin-bottom: var(--space-2);
    }

    .summary-card .value {
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      font-weight: 800;
      line-height: 1;
      color: var(--color-primary);
    }

    .summary-card .value.accent {
      color: var(--color-accent);
    }

    /* Sections */
    .section {
      margin-bottom: var(--space-8);
      page-break-inside: avoid;
    }

    .section-header {
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
      margin-bottom: var(--space-4);
      padding-bottom: var(--space-2);
      border-bottom: 1px solid var(--color-rule);
    }

    .section-header h3 {
      flex: 1;
    }

    .section-header .section-tag {
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-muted);
      font-weight: 600;
    }

    .section-body {
      display: grid;
      gap: var(--space-4);
    }

    /* Meta rows */
    .meta-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }

    .meta-item dt {
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-muted);
      font-weight: 600;
      margin-bottom: var(--space-1);
    }

    .meta-item dd {
      font-size: var(--text-sm);
      font-weight: 500;
      color: var(--color-primary);
    }

    /* Activity items */
    .activity {
      border: 1px solid var(--color-rule);
      border-radius: var(--radius);
      padding: var(--space-4) var(--space-5);
      background: var(--color-surface);
      page-break-inside: avoid;
    }

    .activity-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: var(--space-4);
      margin-bottom: var(--space-3);
    }

    .activity-title {
      font-size: var(--text-lg);
      font-weight: 600;
      color: var(--color-primary);
      line-height: var(--leading-tight);
      margin-bottom: var(--space-1);
    }

    .activity-desc {
      font-size: var(--text-sm);
      color: var(--color-primary-ink);
      line-height: var(--leading-normal);
      max-width: 68ch;
    }

    .badge {
      font-size: var(--text-xs);
      font-weight: 700;
      padding: var(--space-1) var(--space-2);
      border-radius: 100px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .badge-success {
      background: var(--color-success-ink);
      color: var(--color-success);
    }

    .badge-neutral {
      background: var(--color-rule);
      color: var(--color-primary-ink);
    }

    /* Photo grid */
    .photo-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-3);
    }

    .photo {
      border: 1px solid var(--color-rule);
      border-radius: var(--radius);
      overflow: hidden;
      background: var(--color-surface);
    }

    .photo-figure {
      aspect-ratio: 4 / 3;
      background: #000;
      overflow: hidden;
      position: relative;
    }

    .photo-figure img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .photo-caption {
      padding: var(--space-2) var(--space-3);
      background: var(--color-surface);
      border-top: 1px solid var(--color-rule);
      font-size: var(--text-xs);
      color: var(--color-primary-ink);
      font-weight: 500;
    }

    .empty-state {
      padding: var(--space-6);
      text-align: center;
      border: 1px dashed var(--color-rule);
      border-radius: var(--radius);
      background: var(--color-surface);
      font-size: var(--text-sm);
      color: var(--color-muted);
    }

    /* Table */
    .table-wrap {
      border: 1px solid var(--color-rule);
      border-radius: var(--radius);
      overflow: hidden;
      background: var(--color-surface);
    }

    .table-wrap table {
      width: 100%;
    }

    .table-wrap thead th {
      background: var(--color-primary);
      color: #ffffff;
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 600;
      text-align: left;
      padding: var(--space-3) var(--space-4);
      border-bottom: 1px solid var(--color-primary);
    }

    .table-wrap tbody td {
      padding: var(--space-3) var(--space-4);
      font-size: var(--text-sm);
      color: var(--color-primary-ink);
      border-bottom: 1px solid var(--color-rule);
      vertical-align: top;
    }

    .table-wrap tbody tr:last-child td {
      border-bottom: none;
    }

    .table-wrap tbody tr:nth-child(even) {
      background: #f8fafc;
    }

    .attendee {
      font-weight: 600;
      color: var(--color-primary);
      margin-bottom: var(--space-1);
    }

    .attendee-contact {
      font-size: var(--text-xs);
      color: var(--color-muted);
    }

    .mono {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: var(--text-xs);
      color: var(--color-primary-ink);
    }

    .table-empty {
      padding: var(--space-6);
      text-align: center;
      color: var(--color-muted);
      font-size: var(--text-sm);
    }

    /* Footer */
    .doc-footer {
      margin-top: var(--space-10);
      padding-top: var(--space-4);
      border-top: 1.5px solid var(--color-primary);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-4);
      font-size: var(--text-xs);
      color: var(--color-muted);
      page-break-inside: avoid;
    }

    .seal {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-success);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: var(--text-xs);
    }

    .seal::before {
      content: "";
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--color-success);
      display: inline-block;
      flex-shrink: 0;
      box-shadow: inset 0 0 0 1.5px #ffffff;
    }

    /* Print helpers */
    @media print {
      .page {
        padding: 0;
      }
      .section, .doc-header, .doc-footer, .activity, .table-wrap {
        page-break-inside: avoid;
      }
    }
  </style>
</head>
<body>
  <div class="page">
    <header class="doc-header">
      <div>
        <div class="doc-meta">Official Verification Record</div>
        <h1 class="doc-title">Fieldwork Evidence Report</h1>
        <p class="doc-subtitle">
          Audit-ready summary of session attendance, task evidence, and operational metadata.
        </p>
      </div>
      <div class="doc-controls">
        <div><strong>Organization</strong><br/><%= organization.name %></div>
        <div style="margin-top:4px;"><strong>Generated</strong><br/><%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></div>
      </div>
    </header>

    <section class="section">
      <div class="section-header">
        <h3>Session Summary</h3>
        <div class="section-tag">Overview</div>
      </div>
      <div class="summary">
        <div class="summary-card">
          <div class="label">Verified</div>
          <div class="value accent"><%= attendanceCount %></div>
        </div>
        <div class="summary-card">
          <div class="label">Tasks Completed</div>
          <div class="value">
            <% 
              let totalDefs = room.activityDefinitions ? room.activityDefinitions.length : 0;
              let completedCount = 0;
              if (totalDefs > 0 && activitySubmissions) {
                room.activityDefinitions.forEach(function(def) {
                  let sub = activitySubmissions.find(function(s) { return s.activityId === def.id; });
                  if (sub && sub.photos && sub.photos.length >= def.min_photos) {
                    completedCount++;
                  }
                });
              }
            %>
            <%= completedCount %>/<%= totalDefs %>
          </div>
        </div>
        <div class="summary-card">
          <div class="label">Run Time</div>
          <div class="value"><%= formattedDuration %></div>
        </div>
        <div class="summary-card">
          <div class="label">Status</div>
          <div class="value" style="font-size: var(--text-xl); text-transform: capitalize;"><%= room.status %></div>
        </div>
      </div>

      <div class="meta-grid">
        <div class="meta-item">
          <dt>Session</dt>
          <dd><%= room.title %></dd>
        </div>
        <div class="meta-item">
          <dt>Scheduled Start</dt>
          <dd><%= room.scheduledStart ? new Date(room.scheduledStart).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Not scheduled' %></dd>
        </div>
        <div class="meta-item">
          <dt>Scheduled End</dt>
          <dd><%= room.scheduledEnd ? new Date(room.scheduledEnd).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Not scheduled' %></dd>
        </div>
        <div class="meta-item">
          <dt>Actual Start</dt>
          <dd><%= room.actualStart ? new Date(room.actualStart).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Not started' %></dd>
        </div>
        <div class="meta-item">
          <dt>Actual End</dt>
          <dd><%= room.actualEnd ? new Date(room.actualEnd).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : (room.status === 'live' ? 'In Progress' : 'N/A') %></dd>
        </div>
        <div class="meta-item">
          <dt>Record ID</dt>
          <dd class="mono"><%= room.id %></dd>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h3>Fieldwork Checklist & Task Evidence</h3>
        <div class="section-tag">Activities</div>
      </div>
      <div class="section-body">
        <% if (room.activityDefinitions && room.activityDefinitions.length > 0) { %>
          <% room.activityDefinitions.forEach(function(def) { 
            let submission = activitySubmissions ? activitySubmissions.find(function(s) { return s.activityId === def.id; }) : null;
            let photoList = submission ? submission.photos : [];
            let isComplete = photoList.length >= def.min_photos;
          %>
            <article class="activity">
              <div class="activity-header">
                <div>
                  <div class="activity-title"><%= def.title %></div>
                  <% if (def.description) { %>
                    <div class="activity-desc"><%= def.description %></div>
                  <% } %>
                </div>
                <span class="badge <%= isComplete ? 'badge-success' : 'badge-neutral' %>">
                  <%= isComplete ? 'Complete' : 'Pending' %> (<%= photoList.length %>/<%= def.min_photos %>)
                </span>
              </div>

              <% if (photoList.length > 0) { %>
                <div class="photo-grid">
                  <% photoList.forEach(function(photo) { %>
                    <div class="photo">
                      <div class="photo-figure">
                        <img src="<%= photo.url %>" alt="Task evidence"/>
                      </div>
                      <div class="photo-caption">
                        <%= new Date(photo.uploadedAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="empty-state">No photographic evidence uploaded for this activity.</div>
              <% } %>
            </article>
          <% }) %>
        <% } else { %>
          <div class="empty-state">No field tasks configured for this session.</div>
        <% } %>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h3>Verified Attendance Register</h3>
        <div class="section-tag">Register</div>
      </div>
      <div class="section-body">
        <% if (attendanceEntries && attendanceEntries.length > 0) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th style="width: 22%;">Beneficiary</th>
                  <th style="width: 28%;">Contact</th>
                  <th style="width: 30%;">Form Data</th>
                  <th style="width: 10%;">Photo</th>
                  <th style="width: 10%;">Time</th>
                </tr>
              </thead>
              <tbody>
                <% attendanceEntries.forEach(function(entry) { 
                  let name = entry.data.fullName || entry.data.name || entry.data.Name || entry.data.FullName || null;
                  let phone = entry.data.phone || entry.data.phoneNumber || entry.data.Phone || entry.data.Mobile || null;
                  let details = [];
                  Object.keys(entry.data).forEach(function(k) {
                    if (!['name', 'fullName', 'Name', 'FullName', 'phone', 'phoneNumber', 'Phone', 'Mobile'].includes(k)) {
                      details.push(entry.data[k]);
                    }
                  });
                %>
                  <tr>
                    <td>
                      <div class="attendee"><%= name || 'Anonymous' %></div>
                      <% if (phone) { %>
                        <div class="attendee-contact"><%= phone %></div>
                      <% } %>
                    </td>
                    <td class="mono">
                      <% if (details.length > 0) { %>
                        <%= details.join(' · ') %>
                      <% } else { %>
                        <span style="color: var(--color-rule);">—</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (entry.photoUrl) { %>
                        <img src="<%= entry.photoUrl %>" alt="Verification photo" style="width:36px;height:36px;object-fit:cover;border-radius:4px;border:1px solid var(--color-rule);"/>
                      <% } else { %>
                        <span class="mono" style="color: var(--color-rule);">—</span>
                      <% } %>
                    </td>
                    <td>
                      <div class="mono">
                        <%= new Date(entry.submittedAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">No attendance records logged yet.</div>
        <% } %>
    </section>

    <footer class="doc-footer">
      <div>
        <strong>Eventclick</strong> &nbsp;•&nbsp; Official Audit Document &nbsp;•&nbsp; Page <span class="mono">1</span>
      </div>
      <div class="seal">Field Verification Certified</div>
    </footer>
  </div>
</body>
</html>
