<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Event Fieldwork Verification Report</title>
  <style>
    /* Global Styles & Typography */
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap');

    :root {
      --primary: #4f46e5;
      --primary-light: #e0e7ff;
      --primary-dark: #3730a3;
      --slate-50: #f8fafc;
      --slate-100: #f1f5f9;
      --slate-200: #e2e8f0;
      --slate-300: #cbd5e1;
      --slate-400: #94a3b8;
      --slate-500: #64748b;
      --slate-600: #475569;
      --slate-700: #334155;
      --slate-800: #1e293b;
      --slate-900: #0f172a;
      --success: #16a34a;
      --success-bg: #dcfce7;
      --success-dark: #15803d;
      --warning: #d97706;
      --warning-bg: #fef3c7;
      --warning-dark: #b45309;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: var(--slate-800);
      background-color: #ffffff;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      padding: 40px;
    }

    h1, h2, h3, h4 {
      font-family: 'Outfit', sans-serif;
      color: var(--slate-900);
      font-weight: 700;
    }

    /* Print page-breaks and margins */
    @media print {
      body {
        padding: 0;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .page-break {
        page-break-before: always;
      }
      .no-break {
        page-break-inside: avoid;
      }
    }

    /* Top Decorative Bar */
    .top-bar {
      height: 6px;
      background: linear-gradient(90deg, var(--primary) 0%, var(--primary-dark) 100%);
      width: 100%;
      position: absolute;
      top: 0;
      left: 0;
    }

    /* Layout Wrapper */
    .report-container {
      max-width: 900px;
      margin: 0 auto;
      position: relative;
    }

    /* Header */
    .header {
      margin-top: 10px;
      margin-bottom: 30px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--slate-200);
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .header-left .doc-badge {
      display: inline-flex;
      align-items: center;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--primary);
      background-color: var(--primary-light);
      padding: 6px 12px;
      border-radius: 9999px;
      margin-bottom: 12px;
    }

    .header-left h1 {
      font-size: 32px;
      letter-spacing: -0.03em;
      line-height: 1.15;
      color: var(--slate-900);
    }

    .header-left p {
      font-size: 14px;
      color: var(--slate-500);
      margin-top: 6px;
      font-weight: 450;
    }

    .header-right {
      text-align: right;
    }

    .ngo-name {
      font-family: 'Outfit', sans-serif;
      font-weight: 700;
      font-size: 20px;
      color: var(--primary-dark);
      letter-spacing: -0.01em;
    }

    .gen-date {
      font-size: 12px;
      color: var(--slate-500);
      margin-top: 6px;
    }

    /* Event Metadata Grid */
    .overview-grid {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 24px;
      margin-bottom: 24px;
      page-break-inside: avoid;
    }

    .overview-card {
      background-color: var(--slate-50);
      border: 1px solid var(--slate-200);
      border-radius: 12px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
    }

    .overview-title {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--slate-500);
      margin-bottom: 10px;
      font-weight: 700;
    }

    .overview-card h2 {
      font-size: 22px;
      margin-bottom: 10px;
      letter-spacing: -0.02em;
      line-height: 1.25;
      color: var(--slate-900);
    }

    .overview-card p.desc {
      font-size: 13px;
      color: var(--slate-600);
      line-height: 1.6;
      white-space: pre-line;
    }

    .metadata-list {
      list-style: none;
    }

    .metadata-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 0;
      font-size: 13px;
      border-bottom: 1px solid var(--slate-200);
    }

    .metadata-item:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .metadata-item:first-child {
      padding-top: 0;
    }

    .metadata-label {
      color: var(--slate-500);
      font-weight: 500;
    }

    .metadata-value {
      font-weight: 600;
      color: var(--slate-900);
    }

    /* Executive Stats Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-bottom: 35px;
      page-break-inside: avoid;
    }

    .stat-card {
      background-color: #ffffff;
      border: 1px solid var(--slate-200);
      border-top: 4px solid var(--primary);
      border-radius: 12px;
      padding: 20px;
      text-align: center;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px -1px rgba(0, 0, 0, 0.01);
    }

    .stat-card .value {
      font-family: 'Outfit', sans-serif;
      font-size: 36px;
      font-weight: 800;
      color: var(--slate-900);
      line-height: 1.1;
      margin-bottom: 6px;
    }

    .stat-card .label {
      font-size: 11px;
      color: var(--slate-500);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    /* Section Headers */
    .section-title {
      font-size: 20px;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 1px solid var(--slate-200);
      padding-bottom: 10px;
    }

    .section-title::before {
      content: "";
      display: inline-block;
      width: 4px;
      height: 20px;
      background-color: var(--primary);
      border-radius: 2px;
    }

    /* Field Activities Proof Section */
    .activity-container {
      margin-bottom: 24px;
      border: 1px solid var(--slate-200);
      border-radius: 12px;
      padding: 24px;
      background-color: #ffffff;
      page-break-inside: avoid;
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.02);
    }

    .activity-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 16px;
      gap: 16px;
    }

    .activity-title {
      font-size: 17px;
      font-weight: 700;
      color: var(--slate-900);
      letter-spacing: -0.01em;
    }

    .activity-desc {
      font-size: 13px;
      color: var(--slate-500);
      margin-top: 4px;
      line-height: 1.5;
    }

    .activity-badge {
      font-size: 11px;
      font-weight: 700;
      padding: 6px 12px;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      white-space: nowrap;
    }

    .badge-success {
      background-color: var(--success-bg);
      color: var(--success-dark);
    }

    .badge-neutral {
      background-color: var(--slate-100);
      color: var(--slate-600);
    }

    /* Activity Photo Proof Grid */
    .photo-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .photo-card {
      border: 1px solid var(--slate-200);
      border-radius: 8px;
      overflow: hidden;
      background-color: var(--slate-100);
      position: relative;
      height: 160px;
      box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.02);
    }

    .photo-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .photo-meta-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      padding: 8px 12px;
      color: #ffffff;
      font-size: 11px;
      font-weight: 500;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .photo-meta-overlay svg {
      margin-right: 4px;
      flex-shrink: 0;
    }

    .photo-time-text {
      display: flex;
      align-items: center;
    }

    .no-photos {
      padding: 24px;
      text-align: center;
      background-color: var(--slate-50);
      border: 1px dashed var(--slate-300);
      border-radius: 8px;
      font-size: 13px;
      color: var(--slate-500);
      font-style: italic;
    }

    /* Report Sign-off Section */
    .signature-section {
      margin-top: 40px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      page-break-inside: avoid;
    }

    .signature-card {
      background-color: #ffffff;
      border: 1px solid var(--slate-200);
      border-radius: 12px;
      padding: 24px;
      text-align: left;
    }

    .signature-card h4 {
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--slate-500);
      margin-bottom: 30px;
    }

    .signature-line {
      border-bottom: 1.5px solid var(--slate-300);
      margin-bottom: 8px;
      height: 20px;
    }

    .signature-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--slate-900);
    }

    .signature-sub {
      font-size: 11px;
      color: var(--slate-500);
      margin-top: 2px;
    }

    /* Footer stamp */
    .footer {
      margin-top: 60px;
      padding-top: 20px;
      border-top: 1px solid var(--slate-200);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      color: var(--slate-500);
      page-break-inside: avoid;
    }

    .footer-brand {
      font-weight: 600;
      color: var(--slate-700);
    }

    .verification-seal {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--success-dark);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .verification-seal svg {
      color: var(--success);
      flex-shrink: 0;
    }
  </style>
</head>
<body>
  <div class="top-bar"></div>
  <div class="report-container">
    
    <!-- Header -->
    <header class="header">
      <div class="header-left">
        <span class="doc-badge">Verification Record</span>
        <h1>Fieldwork Evidence Report</h1>
        <p>Verification data logged during operational fieldwork session</p>
      </div>
      <div class="header-right">
        <div class="ngo-name"><%= organization.name %></div>
        <div class="gen-date">Generated: <%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></div>
      </div>
    </header>

    <!-- Overview Grid -->
    <section class="overview-grid">
      <div class="overview-card">
        <div class="overview-title">Session Details</div>
        <h2><%= room.title %></h2>
        <% if (room.description) { %>
          <p class="desc"><%= room.description %></p>
        <% } else { %>
          <p class="desc" style="font-style: italic; color: var(--slate-400);">No session description provided.</p>
        <% } %>
      </div>
      <div class="overview-card">
        <div class="overview-title">Operations Log</div>
        <ul class="metadata-list">
          <li class="metadata-item">
            <span class="metadata-label">Session ID</span>
            <span class="metadata-value" style="font-family: monospace; font-size: 12px;"><%= room.id.substring(0, 8) %>...</span>
          </li>
          <li class="metadata-item">
            <span class="metadata-label">Current Status</span>
            <span class="metadata-value" style="text-transform: capitalize;"><%= room.status %></span>
          </li>
          <li class="metadata-item">
            <span class="metadata-label">Actual Start</span>
            <span class="metadata-value">
              <%= room.actualStart ? new Date(room.actualStart).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Not started' %>
            </span>
          </li>
          <li class="metadata-item">
            <span class="metadata-label">Actual End</span>
            <span class="metadata-value">
              <%= room.actualEnd ? new Date(room.actualEnd).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : (room.status === 'live' ? 'In Progress' : 'N/A') %>
            </span>
          </li>
        </ul>
      </div>
    </section>

    <!-- Executive Stats -->
    <section class="stats-grid">
      <div class="stat-card">
        <div class="value"><%= attendanceCount %></div>
        <div class="label">Beneficiaries Verified</div>
      </div>
      <div class="stat-card">
        <div class="value">
          <% 
            let totalDefs = room.activityDefinitions ? room.activityDefinitions.length : 0;
            let completedCount = 0;
            if (totalDefs > 0 && activitySubmissions) {
              room.activityDefinitions.forEach(def => {
                let sub = activitySubmissions.find(s => s.activityId === def.id);
                if (sub && sub.photos && sub.photos.length >= def.min_photos) {
                  completedCount++;
                }
              });
            }
          %>
          <%= completedCount %> / <%= totalDefs %>
        </div>
        <div class="label">Tasks Completed</div>
      </div>
      <div class="stat-card">
        <div class="value"><%= formattedDuration %></div>
        <div class="label">Field Run-Time</div>
      </div>
    </section>

    <!-- Field Activities Log -->
    <section style="margin-bottom: 30px;">
      <h3 class="section-title">Fieldwork Checklist & Task Evidence</h3>
      <% if (room.activityDefinitions && room.activityDefinitions.length > 0) { %>
        <% room.activityDefinitions.forEach(def => { 
          let submission = activitySubmissions ? activitySubmissions.find(s => s.activityId === def.id) : null;
          let photoList = submission ? submission.photos : [];
          let isComplete = photoList.length >= def.min_photos;
        %>
          <div class="activity-container">
            <div class="activity-header">
              <div>
                <span class="activity-title"><%= def.title %></span>
                <% if (def.description) { %>
                  <div class="activity-desc"><%= def.description %></div>
                <% } %>
              </div>
              <span class="activity-badge <%= isComplete ? 'badge-success' : 'badge-neutral' %>">
                <%= isComplete ? 'Complete' : 'Pending' %> (<%= photoList.length %>/<%= def.min_photos %> Photos)
              </span>
            </div>

            <% if (photoList.length > 0) { %>
              <div class="photo-grid">
                <% photoList.forEach(photo => { %>
                  <div class="photo-card">
                    <img src="<%= photo.url %>" alt="Task Proof">
                    <div class="photo-meta-overlay">
                      <div class="photo-time-text">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                        <span><%= new Date(photo.uploadedAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %></span>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="no-photos">
                No fieldwork photographic evidence uploaded for this task yet.
              </div>
            <% } %>
          </div>
        <% }) %>
      <% } else { %>
        <div class="no-photos" style="padding: 30px;">
          No field tasks or activity checklist definitions configured for this session.
        </div>
      <% } %>
    </section>

    <!-- Sign-off Section -->
    <section class="signature-section">
      <div class="signature-card">
        <h4>NGO Representative</h4>
        <div class="signature-line"></div>
        <span class="signature-title">Authorized Administrator Sign-off</span>
        <span class="signature-sub"><%= organization.name %></span>
      </div>
      <div class="signature-card">
        <h4>Field Supervisor</h4>
        <div class="signature-line"></div>
        <span class="signature-title">Lead Facilitator Sign-off</span>
        <span class="signature-sub">Evently System Verified</span>
      </div>
    </section>

    <!-- Footer Stamp -->
    <footer class="footer">
      <div>
        <span class="footer-brand">Evently Verification Engine</span> &bull; Secure Audit Document
      </div>
      <div class="verification-seal">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <span>Field Verification Certified</span>
      </div>
    </footer>

  </div>
</body>
</html>
