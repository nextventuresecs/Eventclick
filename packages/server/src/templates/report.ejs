<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EventClick - Field Monitoring Report</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #2563EB;
            --dark-text: #1F2937;
            --secondary-text: #6B7280;
            --border: #E5E7EB;
            --bg-white: #FFFFFF;
            --bg-section: #F8FAFC;
        }

        /* --- PDF & PRINT PREPARATION --- */
        @page {
            size: A4 portrait;
            margin: 18mm;
            @bottom-right {
                content: "Page " counter(page);
                font-family: 'Inter', sans-serif;
                font-size: 10px;
                color: #6B7280;
            }
            @bottom-left {
                content: "Professional Field Monitoring Report";
                font-family: 'Inter', sans-serif;
                font-size: 10px;
                color: #6B7280;
            }
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--dark-text);
            background: var(--bg-white);
            font-size: 12px;
            line-height: 1.6;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        @media screen {
            body {
                background: #e2e8f0;
                padding: 2rem;
            }
            .a4-container {
                width: 210mm;
                min-height: 297mm;
                margin: 0 auto;
                background: var(--bg-white);
                padding: 18mm;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            }
        }

        /* Utilities */
        .avoid-break { page-break-inside: avoid; break-inside: avoid; }
        .text-primary { color: var(--primary); }
        .text-center { text-align: center; }
        .text-right { text-align: right; }

        h2 { 
            font-size: 18px; 
            font-weight: 700; 
            border-bottom: 2px solid var(--border); 
            padding-bottom: 8px; 
            margin-top: 32px; 
            margin-bottom: 16px; 
            color: var(--primary); 
        }

        /* --- TOP HEADER --- */
        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid var(--primary);
            padding-bottom: 12px;
            margin-bottom: 24px;
            font-size: 11px;
            font-weight: 600;
            color: var(--secondary-text);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* --- ORG SECTION --- */
        .org-header-row {
            display: flex;
            align-items: center;
            gap: 24px;
            margin-bottom: 16px;
        }
        .org-logo {
            width: 100px;
            height: 100px;
            background: var(--bg-section);
            border: 1px dashed var(--secondary-text);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            font-weight: bold;
            color: var(--primary);
            flex-shrink: 0;
        }
        .org-title {
            font-size: 28px;
            font-weight: 800;
            color: var(--dark-text);
            line-height: 1.2;
        }
        .org-paragraph {
            background: var(--bg-section);
            padding: 16px;
            border-radius: 6px;
            border-left: 4px solid var(--primary);
            font-size: 12px;
            color: var(--dark-text);
        }

        /* --- EVENT OVERVIEW --- */
        .event-overview-box {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 32px;
        }
        .event-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 8px;
        }
        .event-about {
            margin-bottom: 16px;
            color: var(--secondary-text);
        }
        .event-bullets {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            list-style: none;
            background: var(--bg-section);
            padding: 16px;
            border-radius: 6px;
        }
        .event-bullets li {
            display: flex;
            align-items: flex-start;
        }
        .bullet-label {
            font-weight: 600;
            width: 90px;
            flex-shrink: 0;
            color: var(--dark-text);
        }

        /* --- ALTERNATING ACTIVITY LIST --- */
        .activity-row {
            display: flex;
            gap: 24px;
            margin-bottom: 32px;
            align-items: stretch;
        }
        .activity-row:nth-child(even) {
            flex-direction: row-reverse;
        }
        .activity-text {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .activity-name {
            font-size: 16px;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 8px;
        }
        .activity-about {
            color: var(--secondary-text);
            margin-bottom: 12px;
        }
        .activity-meta {
            font-size: 11px;
            font-weight: 600;
            background: var(--bg-section);
            display: inline-block;
            padding: 4px 12px;
            border-radius: 999px;
            border: 1px solid var(--border);
            align-self: flex-start;
        }
        .activity-photo-container {
            flex: 1;
            height: 220px;
            background: #E5E7EB;
            border-radius: 8px;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #9CA3AF;
            font-size: 11px;
            overflow: hidden;
            position: relative;
        }

        /* --- TABLES & DATA SECTIONS --- */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 16px;
            font-size: 11px;
        }
        th {
            background: var(--bg-section);
            color: var(--secondary-text);
            font-weight: 600;
            text-align: left;
            padding: 10px 12px;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 10px;
        }
        td {
            padding: 10px 12px;
            border-bottom: 1px solid var(--border);
            color: var(--dark-text);
        }

        /* Attendance KPI Grid */
        .attendance-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-bottom: 16px;
        }
        .attendance-card {
            background: var(--bg-section);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 12px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .attendance-card .label {
            color: var(--secondary-text);
            font-size: 11px;
            font-weight: 500;
        }
        .attendance-card .count {
            font-size: 18px;
            font-weight: 700;
            color: var(--primary);
        }

        /* Member avatar badge */
        .member-badge {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
        }
        .avatar-circle {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--primary);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 700;
        }

        /* --- END OF REPORT BRANDING --- */
        .report-end {
            margin-top: 60px;
            padding-top: 40px;
            border-top: 2px dashed var(--border);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            page-break-inside: avoid;
        }
        .brand-logo-large {
            font-size: 24px;
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .brand-icon {
            width: 32px;
            height: 32px;
            background: var(--primary);
            border-radius: 6px;
            display: inline-block;
        }
        .end-text {
            color: var(--secondary-text);
            font-size: 12px;
            font-weight: 500;
        }
    </style>
</head>
<body>

<div class="a4-container">

    <!-- TOP HEADER -->
    <div class="top-header">
        <span>Report Generated: <%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
        <span>Field Monitoring Report</span>
    </div>

    <!-- MAIN ORG SECTION -->
    <div class="org-header-row avoid-break">
        <div class="org-logo">
            <% if (organization.logoUrl) { %>
                <img src="<%= organization.logoUrl %>" alt="<%= organization.name %> Logo" style="max-height: 48px; max-width: 120px; object-fit: contain;" />
            <% } else { %>
                <%= organization.name.substring(0, 3).toUpperCase() %>
            <% } %>
        </div>
        <div class="org-title"><%= organization.name %></div>
    </div>

    <div class="org-paragraph avoid-break">
        <h2>About the Organization:</h2><%= organization.description %><br>
        <strong>Active Working Members:</strong> <%= organization.members.length %><br>
        <strong>Field Operations:</strong> <%= organization.locations.join(', ') %>
    </div>
    
    <!-- EVENT OVERVIEW -->
    <h2>Event Details</h2>
    <div class="event-overview-box avoid-break">
        <div class="event-title"><%= room.title %></div>
        <div class="event-about">
            <%= room.description %>
        </div>
        <ul class="event-bullets">
            <li><span class="bullet-label">Location:</span> <%= room.location || 'Online / Remote' %></li>
            <li><span class="bullet-label">Date:</span> <%= room.scheduledStart ? new Date(room.scheduledStart).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'N/A' %></li>
            <li><span class="bullet-label">Attendees:</span> <%= attendanceCount %> Registered Beneficiary</li>
            <li><span class="bullet-label">Scheduled:</span> <%= room.scheduledStart ? new Date(room.scheduledStart).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>  -  <%= room.scheduledEnd ? new Date(room.scheduledEnd).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Not scheduled' %></li>
            <li><span class="bullet-label">Actual:</span> <%= room.actualStart ? new Date(room.actualStart).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>  -  <%= room.actualEnd ? new Date(room.actualEnd).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></li>
            <li><span class="bullet-label">Total Duration:</span> <%= formattedDuration %></li>
            <li><span class="bullet-label">Tasks Completed:</span> 
                <% 
                  let totalDefs = room.activityDefinitions ? room.activityDefinitions.length : 0;
                  let completedCount = 0;
                  if (totalDefs > 0 && activitySubmissions) {
                    room.activityDefinitions.forEach(function(def) {
                      let sub = activitySubmissions.find(function(s) { return s.activityId === def.id; });
                      if (sub && sub.photos && sub.photos.length >= def.min_photos) {
                        completedCount++;
                      }
                    });
                  }
                %>
                <%= completedCount %>/<%= totalDefs %>
            </li>
        </ul>
    </div>

    <!-- EVENT ACTIVITIES -->
    <h2>Event Activities</h2>
    <% if (room.activityDefinitions && room.activityDefinitions.length > 0) { %>
        <% room.activityDefinitions.forEach(function(def) { 
          let submission = activitySubmissions ? activitySubmissions.find(function(s) { return s.activityId === def.id; }) : null;
          let photoList = submission ? submission.photos : [];
          let isComplete = photoList.length >= def.min_photos;
        %>
        <div class="activity-row avoid-break">
            <div class="activity-text">
                <div class="activity-name"><%= def.title %></div>
                <% if (def.description) { %>
                    <div class="activity-about"><%= def.description %></div>
                <% } %>
                <div class="activity-meta">
                    <%= isComplete ? 'Complete' : 'Pending' %> (<%= photoList.length %>/<%= def.min_photos %> photos)
                </div>
            </div>
            <div class="activity-photo-container">
                <% if (photoList.length > 0) { %>
                    <div class="photo-grid">
                        <% photoList.slice(0, 4).forEach(function(photo) { %>
                            <img src="<%= photo.url %>" alt="Task evidence"/>
                        <% }) %>
                    </div>
                <% } else { %>
                    No photographic evidence uploaded.
                <% } %>
            </div>
        </div>
        <% }) %>
    <% } else { %>
        <div class="empty-state">No field tasks configured for this session.</div>
    <% } %>

    <!-- COMPLETE ACTIVITY LOG (ATTENDANCE REGISTER) -->
    <h2>Complete Activity Log</h2>
    <div class="avoid-break">
        <% if (attendanceEntries && attendanceEntries.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th width="8%" class="text-center">Sr.</th>
                        <th width="37%">Activity Name</th>
                        <th width="15%">Start Time</th>
                        <th width="15%">End Time</th>
                        <th width="13%">Duration</th>
                        <th width="12%" class="text-center">Photos</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (room.activityDefinitions && room.activityDefinitions.length > 0) { %>
                        <% room.activityDefinitions.forEach(function(def, index) { 
                            let submission = activitySubmissions ? activitySubmissions.find(function(s) { return s.activityId === def.id; }) : null;
                            let startTime = submission ? new Date(submission.createdAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : '—';
                            let endTime = submission ? new Date(submission.updatedAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : '—';
                            let photoCount = submission && submission.photos ? submission.photos.length : 0;
                            
                            let duration = '—';
                            if (submission) {
                                let diffMs = new Date(submission.updatedAt).getTime() - new Date(submission.createdAt).getTime();
                                if (diffMs === 0) {
                                    duration = 'Instant';
                                } else {
                                    let diffMins = Math.round(diffMs / 60000);
                                    duration = diffMins + ' min';
                                }
                            }
                        %>
                        <tr>
                            <td class="text-center"><%= index + 1 %></td>
                            <td><strong><%= def.title %></strong></td>
                            <td><%= startTime %></td>
                            <td><%= endTime %></td>
                            <td><%= duration %></td>
                            <td class="text-center"><%= photoCount %> / <%= def.min_photos %></td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center">No activities configured.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
    </div>

    <!-- END OF REPORT BRANDING -->
    <div class="report-end">
        <div class="brand-logo-large">
            <img src="data:image/webp;base64," alt="" width="497" height="502" />
            EventClick
        </div>
        <div class="end-text">
            This field report was securely generated by the EventClick Platform.<br>
            Official Verification Record.
        </div>
    </div>

</div>

</body>
</html>
