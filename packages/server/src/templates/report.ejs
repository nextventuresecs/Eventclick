<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Event Fieldwork Verification Report</title>
  <style>
    /* Design Tokens */
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800&display=swap');

    :root {
      /* Colors */
      --primary: hsl(239, 84%, 60%);
      --primary-dark: hsl(239, 84%, 45%);
      --primary-bg: hsl(239, 84%, 96%);
      --slate-50: hsl(210, 40%, 98%);
      --slate-100: hsl(210, 40%, 96%);
      --slate-200: hsl(214, 32%, 91%);
      --slate-300: hsl(212, 27%, 84%);
      --slate-700: hsl(215, 25%, 27%);
      --slate-800: hsl(215, 29%, 18%);
      --slate-900: hsl(220, 39%, 10%);
      --success: hsl(142, 72%, 29%);
      --success-bg: hsl(142, 72%, 95%);
      
      /* Spacing Scale (4px base) */
      --space-1: 4px;
      --space-2: 8px;
      --space-3: 12px;
      --space-4: 16px;
      --space-5: 20px;
      --space-6: 24px;
      --space-8: 32px;
      --space-10: 40px;
      --space-12: 48px;
      
      /* Typography Scale */
      --text-xs: 11px;
      --text-sm: 13px;
      --text-base: 14px;
      --text-lg: 16px;
      --text-xl: 18px;
      --text-2xl: 22px;
      --text-3xl: 28px;
      
      /* Line Heights */
      --leading-tight: 1.25;
      --leading-normal: 1.5;
      --leading-relaxed: 1.625;
      
      /* Border Radius */
      --radius-sm: 6px;
      --radius-md: 8px;
      --radius-lg: 12px;
      
      /* Shadows */
      --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
      --shadow-md: 0 2px 4px rgba(0,0,0,0.06);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-size: var(--text-base);
      color: var(--slate-800);
      background: #ffffff;
      line-height: var(--leading-normal);
      -webkit-font-smoothing: antialiased;
      padding: var(--space-10);
    }

    h1, h2, h3, h4 {
      font-family: 'Outfit', sans-serif;
      color: var(--slate-900);
      font-weight: 700;
      line-height: var(--leading-tight);
      letter-spacing: -0.02em;
    }

    h1 { font-size: var(--text-3xl); }
    h2 { font-size: var(--text-2xl); }
    h3 { font-size: var(--text-xl); }

    /* Print Optimization */
    @media print {
      body {
        padding: 0;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .page-break { page-break-before: always; }
      .no-break { page-break-inside: avoid; }
    }

    /* Top Bar */
    .top-bar {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: var(--space-2);
      background: linear-gradient(90deg, var(--primary) 0%, var(--primary-dark) 100%);
    }

    /* Layout */
    .report-container {
      max-width: 900px;
      margin: 0 auto;
      position: relative;
    }

    /* Header */
    .header {
      margin-bottom: var(--space-8);
      padding-bottom: var(--space-6);
      border-bottom: 2px solid var(--slate-100);
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: var(--space-6);
    }

    .doc-badge {
      display: inline-block;
      font-size: var(--text-xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--primary);
      background: var(--primary-bg);
      padding: var(--space-1) var(--space-2);
      border-radius: var(--radius-sm);
      margin-bottom: var(--space-2);
    }

    .header-left h1 {
      margin-bottom: var(--space-1);
    }

    .header-left p {
      font-size: var(--text-sm);
      color: var(--slate-700);
      line-height: var(--leading-relaxed);
    }

    .header-right {
      text-align: right;
      flex-shrink: 0;
    }

    .ngo-name {
      font-family: 'Outfit', sans-serif;
      font-weight: 600;
      font-size: var(--text-xl);
      color: var(--slate-900);
      margin-bottom: var(--space-1);
    }

    .gen-date {
      font-size: var(--text-xs);
      color: var(--slate-700);
    }

    /* Overview Grid */
    .overview-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: var(--space-6);
      margin-bottom: var(--space-8);
    }

    .overview-card {
      background: var(--slate-50);
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
    }

    .overview-title {
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--slate-700);
      font-weight: 600;
      margin-bottom: var(--space-2);
    }

    .overview-card h2 {
      margin-bottom: var(--space-2);
      word-wrap: break-word;
    }

    .overview-card .desc {
      font-size: var(--text-sm);
      color: var(--slate-700);
      line-height: var(--leading-relaxed);
      white-space: pre-line;
      max-width: 60ch;
    }

    .metadata-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .metadata-item {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-3);
      padding: var(--space-2) 0;
      font-size: var(--text-sm);
      border-bottom: 1px dashed var(--slate-200);
    }

    .metadata-item:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .metadata-label {
      color: var(--slate-700);
      font-weight: 500;
    }

    .metadata-value {
      font-weight: 600;
      color: var(--slate-900);
      text-align: right;
    }

    /* Stats Grid */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
      margin-bottom: var(--space-10);
    }

    .stat-card {
      background: #ffffff;
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      text-align: center;
      box-shadow: var(--shadow-sm);
    }

    .stat-card .value {
      font-family: 'Outfit', sans-serif;
      font-size: var(--space-8);
      font-weight: 800;
      color: var(--primary);
      line-height: 1;
      margin-bottom: var(--space-2);
    }

    .stat-card .label {
      font-size: var(--text-xs);
      color: var(--slate-700);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      line-height: var(--leading-normal);
    }

    /* Section Title */
    .section-title {
      font-size: var(--text-xl);
      margin-bottom: var(--space-4);
      display: flex;
      align-items: center;
      gap: var(--space-2);
      border-bottom: 2px solid var(--slate-100);
      padding-bottom: var(--space-2);
    }

    .section-title::before {
      content: "";
      width: var(--space-1);
      height: var(--text-xl);
      background: var(--primary);
      border-radius: 2px;
      flex-shrink: 0;
    }

    /* Activity Container */
    .activity-container {
      margin-bottom: var(--space-6);
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      background: #ffffff;
      page-break-inside: avoid;
    }

    .activity-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: var(--space-4);
      margin-bottom: var(--space-3);
    }

    .activity-title {
      font-size: var(--text-lg);
      font-weight: 600;
      color: var(--slate-900);
      line-height: var(--leading-tight);
    }

    .activity-desc {
      font-size: var(--text-sm);
      color: var(--slate-700);
      line-height: var(--leading-relaxed);
      margin-bottom: var(--space-4);
      max-width: 70ch;
    }

    .activity-badge {
      font-size: var(--text-xs);
      font-weight: 600;
      padding: var(--space-1) var(--space-2);
      border-radius: 100px;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .badge-success {
      background: var(--success-bg);
      color: var(--success);
    }

    .badge-neutral {
      background: var(--slate-100);
      color: var(--slate-700);
    }

    /* Photo Grid */
    .photo-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--space-3);
    }

    .photo-card {
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-md);
      overflow: hidden;
      background: var(--slate-50);
      box-shadow: var(--shadow-sm);
    }

    .photo-wrapper {
      aspect-ratio: 4 / 3;
      position: relative;
      background: #000;
      overflow: hidden;
    }

    .photo-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .photo-meta {
      padding: var(--space-2) var(--space-3);
      background: #ffffff;
      border-top: 1px solid var(--slate-200);
    }

    .photo-timestamp {
      font-size: var(--text-xs);
      color: var(--slate-700);
      font-weight: 500;
    }

    .no-photos {
      padding: var(--space-8);
      text-align: center;
      background: var(--slate-50);
      border: 1px dashed var(--slate-200);
      border-radius: var(--radius-md);
      font-size: var(--text-sm);
      color: var(--slate-700);
    }

    /* Attendance Table */
    .attendance-table-container {
      margin-top: var(--space-5);
      border: 1px solid var(--slate-200);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }

    .attendance-table {
      width: 100%;
      border-collapse: collapse;
    }

    .attendance-table th {
      background: var(--slate-50);
      padding: var(--space-3) var(--space-4);
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--slate-700);
      border-bottom: 1px solid var(--slate-200);
      font-weight: 600;
      text-align: left;
    }

    .attendance-table td {
      padding: var(--space-4);
      font-size: var(--text-sm);
      border-bottom: 1px solid var(--slate-100);
      color: var(--slate-800);
      vertical-align: middle;
    }

    .attendance-table tr:last-child td {
      border-bottom: none;
    }

    .attendee-name {
      font-weight: 600;
      color: var(--slate-900);
      margin-bottom: var(--space-1);
      font-size: var(--text-base);
    }

    .attendee-phone {
      font-size: var(--text-xs);
      color: var(--slate-700);
    }

    .attendee-img {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-sm);
      object-fit: cover;
      border: 1px solid var(--slate-200);
      background: var(--slate-100);
    }

    .attendee-no-img {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-sm);
      background: var(--slate-200);
      color: var(--slate-700);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: var(--text-xs);
      font-weight: 600;
      border: 1px dashed var(--slate-300);
    }

    .submitted-time {
      font-family: 'SF Mono', 'Monaco', 'Consolas', monospace;
      font-size: var(--text-xs);
      color: var(--slate-700);
    }

    /* Footer */
    .footer {
      margin-top: var(--space-10);
      padding-top: var(--space-5);
      border-top: 1px solid var(--slate-200);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: var(--text-xs);
      color: var(--slate-700);
      page-break-inside: avoid;
    }

    .verification-seal {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--success);
      font-weight: 600;
    }

    .verification-seal::before {
      content: "✓";
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 16px;
      height: 16px;
      background: var(--success);
      color: #ffffff;
      border-radius: 50%;
      font-size: 10px;
      font-weight: 700;
    }
  </style>
</head>
<body>
  <div class="top-bar"></div>
  <div class="report-container">
    
    <header class="header">
      <div class="header-left">
        <span class="doc-badge">Verification Record</span>
        <h1>Fieldwork Evidence Report</h1>
        <p>Verification data logged during operational fieldwork session</p>
      </div>
      <div class="header-right">
        <div class="ngo-name"><%= organization.name %></div>
        <div class="gen-date">Generated: <%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></div>
      </div>
    </header>

    <section class="overview-grid">
      <div class="overview-card">
        <div class="overview-title">Session Details</div>
        <h2><%= room.title %></h2>
        <% if (room.description) { %>
          <p class="desc"><%= room.description %></p>
        <% } else { %>
          <p class="desc" style="font-style: italic; color: hsl(215, 20%, 60%);">No session description provided.</p>
        <% } %>
      </div>
      <div class="overview-card">
        <div class="overview-title">Operations Log</div>
        <ul class="metadata-list">
          <li class="metadata-item">
            <span class="metadata-label">Session ID</span>
            <span class="metadata-value" style="font-family: monospace; font-size: var(--text-xs);"><%= room.id.substring(0, 8) %>...</span>
          </li>
          <li class="metadata-item">
            <span class="metadata-label">Status</span>
            <span class="metadata-value" style="text-transform: capitalize;"><%= room.status %></span>
          </li>
          <li class="metadata-item">
            <span class="metadata-label">Start</span>
            <span class="metadata-value">
              <%= room.actualStart ? new Date(room.actualStart).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Not started' %>
            </span>
          </li>
          <li class="metadata-item">
            <span class="metadata-label">End</span>
            <span class="metadata-value">
              <%= room.actualEnd ? new Date(room.actualEnd).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : (room.status === 'live' ? 'In Progress' : 'N/A') %>
            </span>
          </li>
        </ul>
      </div>
    </section>

    <section class="stats-grid">
      <div class="stat-card">
        <div class="value"><%= attendanceCount %></div>
        <div class="label">Beneficiaries Verified</div>
      </div>
      <div class="stat-card">
        <div class="value">
          <% 
            let totalDefs = room.activityDefinitions ? room.activityDefinitions.length : 0;
            let completedCount = 0;
            if (totalDefs > 0 && activitySubmissions) {
              room.activityDefinitions.forEach(def => {
                let sub = activitySubmissions.find(s => s.activityId === def.id);
                if (sub && sub.photos && sub.photos.length >= def.min_photos) {
                  completedCount++;
                }
              });
            }
          %>
          <%= completedCount %> / <%= totalDefs %>
        </div>
        <div class="label">Tasks Completed</div>
      </div>
      <div class="stat-card">
        <div class="value"><%= formattedDuration %></div>
        <div class="label">Field Run-Time</div>
      </div>
    </section>

    <section class="no-break" style="margin-bottom: var(--space-8);">
      <h3 class="section-title">Fieldwork Checklist & Task Evidence</h3>
      <% if (room.activityDefinitions && room.activityDefinitions.length > 0) { %>
        <% room.activityDefinitions.forEach(def => { 
          let submission = activitySubmissions ? activitySubmissions.find(s => s.activityId === def.id) : null;
          let photoList = submission ? submission.photos : [];
          let isComplete = photoList.length >= def.min_photos;
        %>
          <div class="activity-container">
            <div class="activity-header">
              <div>
                <div class="activity-title"><%= def.title %></div>
                <% if (def.description) { %>
                  <div class="activity-desc"><%= def.description %></div>
                <% } %>
              </div>
              <span class="activity-badge <%= isComplete ? 'badge-success' : 'badge-neutral' %>">
                <%= isComplete ? 'Complete' : 'Pending' %> (<%= photoList.length %>/<%= def.min_photos %>)
              </span>
            </div>

            <% if (photoList.length > 0) { %>
              <div class="photo-grid">
                <% photoList.forEach(photo => { %>
                  <div class="photo-card">
                    <div class="photo-wrapper">
                      <img src="<%= photo.url %>" alt="Task evidence">
                    </div>
                    <div class="photo-meta">
                      <div class="photo-timestamp">
                        <%= new Date(photo.uploadedAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="no-photos">No photographic evidence uploaded yet</div>
            <% } %>
          </div>
        <% }) %>
      <% } else { %>
        <div class="no-photos">No field tasks configured for this session</div>
      <% } %>
    </section>

    <section class="page-break no-break">
      <h3 class="section-title">Verified Beneficiary Register</h3>
      <% if (attendanceEntries && attendanceEntries.length > 0) { %>
        <div class="attendance-table-container">
          <table class="attendance-table">
            <thead>
              <tr>
                <th style="width: 25%;">Beneficiary</th>
                <th style="width: 35%;">Form Data</th>
                <th style="width: 15%;">Photo</th>
                <th style="width: 15%;">Time</th>
              </tr>
            </thead>
            <tbody>
              <% attendanceEntries.forEach(entry => { 
                let name = entry.data.fullName || entry.data.name || entry.data.Name || entry.data.FullName || null;
                let phone = entry.data.phone || entry.data.phoneNumber || entry.data.Phone || entry.data.Mobile || null;
                
                let details = [];
                Object.keys(entry.data).forEach(k => {
                  if (!['name', 'fullName', 'Name', 'FullName', 'phone', 'phoneNumber', 'Phone', 'Mobile'].includes(k)) {
                    details.push(`${k}: ${entry.data[k]}`);
                  }
                });
              %>
                <tr>
                  <td>
                    <div class="attendee-name"><%= name || 'Anonymous' %></div>
                    <% if (phone) { %>
                      <div class="attendee-phone"><%= phone %></div>
                    <% } %>
                  </td>
                  <td style="font-size: var(--text-xs); color: var(--slate-700);">
                    <% if (details.length > 0) { %>
                      <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-1);">
                        <% details.forEach(detail => { %>
                          <li><%= detail %></li>
                        <% }) %>
                      </ul>
                    <% } else { %>
                      <span style="color: var(--slate-300); font-style: italic;">No additional data</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (entry.photoUrl) { %>
                      <img class="attendee-img" src="<%= entry.photoUrl %>" alt="Verification photo">
                    <% } else { %>
                      <div class="attendee-no-img">—</div>
                    <% } %>
                  </td>
                  <td>
                    <div class="submitted-time">
                      <%= new Date(entry.submittedAt).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="no-photos">No attendance records logged yet</div>
      <% } %>
    </section>

    <footer class="footer">
      <div><strong>Evently Verification Engine</strong> • Secure Audit Document</div>
      <div class="verification-seal">Field Verification Certified</div>
    </footer>

  </div>
</body>
</html>