# ─── Stage 1: deps ────────────────────────────────────────────────────────────
FROM node:22-alpine AS deps
WORKDIR /app

# Copy workspace manifests only (cache layer)
COPY package.json package-lock.json turbo.json tsconfig.json ./
COPY packages/server/package.json  ./packages/server/
COPY packages/shared/package.json  ./packages/shared/

# Install production + dev deps (needed for TypeScript compile)
RUN npm ci

# ─── Stage 2: build ───────────────────────────────────────────────────────────
FROM deps AS build
WORKDIR /app

# Copy source
COPY packages/server ./packages/server
COPY packages/shared ./packages/shared

# Compile TypeScript → dist/
RUN npm run build --workspace=packages/shared
RUN npm run build --workspace=packages/server
RUN cp -r packages/server/src/templates packages/server/dist/templates

# ─── Stage 3: runner ──────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser  --system --uid 1001 Eventclick

# Install production deps only (exclude devDependencies to reduce attack surface)
COPY package.json package-lock.json turbo.json tsconfig.json ./
COPY packages/server/package.json  ./packages/server/
COPY packages/shared/package.json  ./packages/shared/

RUN npm ci --omit=dev && npm cache clean --force && rm -rf /usr/local/lib/node_modules/npm

# Copy compiled output
COPY --from=build  /app/packages/server/dist      ./packages/server/dist
COPY --from=build  /app/packages/server/drizzle      ./packages/server/drizzle
COPY --from=build  /app/packages/shared/dist      ./packages/shared/dist

USER Eventclick

EXPOSE 4000

CMD ["node", "packages/server/dist/index.js"]
