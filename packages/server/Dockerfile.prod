# ─── Stage 1: deps ────────────────────────────────────────────────────────────
FROM node:22-alpine AS deps
WORKDIR /app

# Copy workspace manifests only (cache layer)
COPY package.json package-lock.json turbo.json tsconfig.json ./
COPY packages/server/package.json  ./packages/server/
COPY packages/shared/package.json  ./packages/shared/
# ops: its Vite/React devDependencies are needed to build the Ops Console.
COPY packages/ops/package.json     ./packages/ops/

# Install production + dev deps (needed for TypeScript compile)
RUN npm ci

# ─── Stage 2: build ───────────────────────────────────────────────────────────
FROM deps AS build
WORKDIR /app

# Copy source
COPY packages/server ./packages/server
COPY packages/shared ./packages/shared
COPY packages/ops    ./packages/ops

# Compile TypeScript → dist/
RUN npm run build --workspace=packages/shared
RUN npm run build --workspace=packages/server
RUN cp -r packages/server/src/templates packages/server/dist/templates
# Ops Console frontend, served by ops-server (ops-entry.js) from this image.
RUN npm run build --workspace=packages/ops

# ─── Stage 3: runner ──────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# Patch OS packages before anything else. The base tag is not rebuilt on every
# Alpine security release, so a fresh `docker build` can still ship a known-
# vulnerable libcrypto3 — which is exactly what the image scan (#95) caught.
# This pulls the fixed package versions at build time.
RUN apk --no-cache upgrade

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser  --system --uid 1001 Eventclick

# Install production deps only (exclude devDependencies to reduce attack surface)
COPY package.json package-lock.json turbo.json tsconfig.json ./
COPY packages/server/package.json  ./packages/server/
COPY packages/shared/package.json  ./packages/shared/
# packages/ops is deliberately absent: it ships as static files in dist/, and
# its React/Vite dependencies have no business in the runtime image.

RUN npm ci --omit=dev && npm cache clean --force && rm -rf /usr/local/lib/node_modules/npm

# Copy compiled output
COPY --from=build  /app/packages/server/dist      ./packages/server/dist
COPY --from=build  /app/packages/server/drizzle      ./packages/server/drizzle
COPY --from=build  /app/packages/shared/dist      ./packages/shared/dist
COPY --from=build  /app/packages/ops/dist         ./packages/ops/dist

USER Eventclick

EXPOSE 4000

CMD ["node", "packages/server/dist/index.js"]
