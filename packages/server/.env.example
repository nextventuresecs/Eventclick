# ───────────────────────────────────────────────────────────
# Evently Server — Environment Variables
# Copy this file to .env and fill in the values.
# ───────────────────────────────────────────────────────────

# ─── App ──────────────────────────────────────────────────
NODE_ENV=development            # development | test | production
PORT=4000                       # API listen port
LOG_LEVEL=debug                 # fatal | error | warn | info | debug | trace | silent (optional)

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/evently
REDIS_URL=redis://localhost:6379

# ─── JWT / Auth ──────────────────────────────────────────
JWT_SECRET=change-me-at-least-16-chars
JWT_REFRESH_SECRET=change-me-at-least-16-chars-too
JWT_ACCESS_TTL=15m              # default: 15m
JWT_REFRESH_TTL=7d              # default: 7d
BCRYPT_ROUNDS=12                # 10–15, default: 12

# ─── CORS / Cookies ─────────────────────────────────────
CORS_ORIGIN=http://localhost:3000    # comma-separated for multiple origins
APP_URL=http://localhost:3000
COOKIE_DOMAIN=                       # optional, e.g. ".example.com" for prod

# ─── Rate Limiting ──────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000      # default: 60000 (1 min)
RATE_LIMIT_MAX=100              # default: 100 requests/window

# ─── Google OAuth (optional) ─────────────────────────────
GOOGLE_CLIENT_ID=               # leave empty to disable Google sign-in

# ─── LiveKit ─────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-at-least-16-chars

# ─── S3 / MinIO (dev) / Cloudflare R2 (prod) ────────────
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=evently
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true        # true for MinIO, false for R2/AWS
