# ─── Stage 1: deps ────────────────────────────────────────────────────────────
FROM node:22-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json turbo.json tsconfig.json ./
COPY packages/client/package.json  ./packages/client/
COPY packages/shared/package.json  ./packages/shared/

RUN npm ci

# ─── Stage 2: build ───────────────────────────────────────────────────────────
FROM deps AS build
WORKDIR /app

# Build-time env vars (injected by CI/deploy pipeline)
ARG VITE_API_URL
ARG VITE_LIVEKIT_URL
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_SENTRY_CLIENT_DSN
ARG VITE_SENTRY_RELEASE

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_LIVEKIT_URL=$VITE_LIVEKIT_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_SENTRY_CLIENT_DSN=$VITE_SENTRY_CLIENT_DSN
ENV VITE_SENTRY_RELEASE=$VITE_SENTRY_RELEASE

COPY packages/shared ./packages/shared
COPY packages/client ./packages/client

RUN npm run build --workspace=packages/shared

# SENTRY_AUTH_TOKEN arrives as a BuildKit secret, never as an ARG. An ARG's
# value is recorded in that stage's layer metadata, and this build exports its
# cache with `mode=max` — which would publish the token to the GitHub Actions
# cache along with every other build layer. A secret mount exists only for the
# lifetime of this RUN and is not written to any layer.
#
# Absent (local builds, forks, PR builds) the file does not exist, the variable
# is empty, and vite.config.ts skips upload entirely — no source maps are
# emitted and the build behaves exactly as it did before.
RUN --mount=type=secret,id=sentry_auth_token \
    SENTRY_AUTH_TOKEN="$(cat /run/secrets/sentry_auth_token 2>/dev/null || true)" \
    npm run build --workspace=packages/client

# Unconditional, and not a duplicate of the plugin's own cleanup: that only
# runs after a *successful* upload, and the upload is deliberately non-fatal.
# Without this, a failed upload would leave .map files in dist, which stage 3
# copies wholesale into the nginx root — publishing readable client source to
# anyone who asks for it.
RUN find packages/client/dist -name '*.map' -delete

# ─── Stage 3: runner (Nginx) ──────────────────────────────────────────────────
FROM nginx:1.29-alpine AS runner

# Patch OS packages before anything else. The base tag is not rebuilt on every
# Alpine security release, so a fresh `docker build` can still ship a known-
# vulnerable libcrypto3 — which is exactly what the image scan (#95) caught.
# This pulls the fixed package versions at build time.
RUN apk --no-cache upgrade

RUN rm /etc/nginx/conf.d/default.conf

# common.conf goes OUTSIDE conf.d — nginx auto-includes *.conf in conf.d/
# at the http{} level, and common.conf contains location{} blocks that
# are only legal inside server{}. Keeping it in a separate snippets dir
# avoids the double-include.
RUN mkdir -p /etc/nginx/snippets
COPY packages/client/nginx.conf /etc/nginx/conf.d/Eventclick.conf
COPY packages/client/common.conf /etc/nginx/snippets/common.conf
COPY packages/client/cloudflare-realip.conf /etc/nginx/snippets/cloudflare-realip.conf

# Copy built static assets
COPY --from=build /app/packages/client/dist /usr/share/nginx/html

# Give nginx user access to runtime dirs and content
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d /etc/nginx/snippets && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid

EXPOSE 8080

USER nginx

CMD ["nginx", "-g", "daemon off;"]
