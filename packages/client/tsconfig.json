{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@application/shared": ["../shared/src/index.ts"]
    },
    "types": ["node", "vite/client"],
    "moduleResolution": "bundler",
    "module": "ESNext"
  },
  "include": ["src", "vite.config.ts", "../shared/src"],
  "exclude": ["node_modules", "dist"]
}