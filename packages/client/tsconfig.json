{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "vite/client"],
    "moduleResolution": "bundler",
    "module": "ESNext"
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}