# ─── Database ───────────────────────────────────────
DB_USER=Eventclick_admin
DB_PASSWORD=1234
DB_NAME=Eventclick_db
DB_PORT=5433
# Migrations and Drizzle tooling only (db:migrate, db:generate, db:studio).
DATABASE_URL=postgresql://Eventclick_admin:1234@localhost:5433/Eventclick_db

# Runtime connections — both are required or the server exits at startup.
# APP_* connects as the RLS-constrained tenant role; AUTH_* runs auth/session
# work that must sit outside tenant RLS. Point them at dedicated roles in any
# deployed environment; sharing the admin role locally is fine.
APP_DATABASE_URL=postgresql://app_user_login:1234@localhost:5433/Eventclick_db
AUTH_DATABASE_URL=postgresql://auth_svc_role:1234@localhost:5433/Eventclick_db

# Connection-pool and per-session database timeouts. These apply to the
# runtime pools only — the migration connection (DATABASE_URL) never gets
# them, because migrations legitimately run for minutes.
DB_ACQUIRE_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT=15s
DB_IDLE_TX_TIMEOUT=30s
# Ceiling a background job raises for its own transaction (bulk purges).
DB_JOB_STATEMENT_TIMEOUT=5min

# ─── Redis ──────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD="<your-redis-password>"

API_PORT=4000
PORT=4000
NODE_ENV=development

# ─── Email Configuration ────────────────────────────
RESEND_API_KEY="<your-resend-api-key>"
RESEND_FROM_EMAIL="noreply@Eventclick.live"

# Logger: fatal|error|warn|info|debug|trace|silent. Leave blank for env default (debug in dev, info in prod).
LOG_LEVEL=warn

# Generate with: openssl rand -base64 48
JWT_SECRET="<your-jwt-secret>"
JWT_REFRESH_SECRET="<your-jwt-refresh-secret>"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Attendance window buffers in minutes
ATTENDANCE_WINDOW_BEFORE_MINUTES=15
ATTENDANCE_WINDOW_AFTER_MINUTES=30

# Leave blank in local dev; set for production cross-subdomain cookies
COOKIE_DOMAIN=

# bcrypt cost factor (10–15; 12 is the modern default)
BCRYPT_ROUNDS=12

# ─── Google OAuth (optional) ────────────────────────
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins should include APP_URL (http://localhost:3000)
GOOGLE_CLIENT_ID="<your-google-client-id>"

# ─── Client ─────────────────────────────────────────
CLIENT_PORT=3000
VITE_API_URL=http://localhost:4000/api/v1
APP_URL=http://localhost:3000

# Same value as GOOGLE_CLIENT_ID above (client needs it too)
VITE_GOOGLE_CLIENT_ID="<your-google-client-id>"

# ─── LiveKit (self-hosted WebRTC SFU) ───────────────
# Generate for prod: openssl rand -hex 16 (API_KEY), openssl rand -base64 32 (API_SECRET)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevse
# Server-side (inside docker network)
LIVEKIT_URL=ws://livekit:7880
# Sent to browsers in token response (must be reachable from host)
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Browser-side env for client SPA
VITE_LIVEKIT_URL=ws://localhost:7880

# ─── S3-compatible storage (MinIO dev, Cloudflare R2 prod) ──
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
# Presigned URLs use this origin so browser can reach MinIO from host
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=Eventclick-recordings
S3_ACCESS_KEY="<your-s3-access-key>"
S3_SECRET_KEY="<your-s3-secret-key>"
S3_FORCE_PATH_STYLE=true

SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/940278682995/eventclick-email-queue
# ─── Data retention (GDPR) ───────────────────────────────────────────────────
# Days to keep attendance, activity photos, submissions and recordings. Must
# match what docs/GDPR_COMPLIANCE_REPORT.md publishes.
DATA_RETENTION_DAYS=365
# Ships enabled: the purge has never run, so its first pass faces an unmeasured
# backlog. It reports what it would delete until you set this to "false".
# See docs/runbooks/data-retention.md before turning it off.
DATA_RETENTION_DRY_RUN=true

# ─── Audit log retention ─────────────────────────────────────────────────────
# Days to keep audit_logs rows. 365 is the standard security/audit log period:
# PCI DSS v4.0 req. 10.5.1 (12 months), CIS Controls v8 control 8.10 (12 months
# recommended), and what SOC 2 / ISO 27001 programmes conventionally evidence.
# GDPR sets no period and art. 5(1)(e) argues against keeping longer without a
# reason. Must be >= DATA_RETENTION_DAYS — the server refuses to start otherwise.
AUDIT_RETENTION_DAYS=365
# Ships enabled, and separate from DATA_RETENTION_DRY_RUN on purpose: deleting
# the record of what happened is a different decision from deleting the event
# data it describes. See docs/runbooks/audit-retention.md.
AUDIT_RETENTION_DRY_RUN=true

# ─── Audit log archive (WORM) ────────────────────────────────────────────────
# R2 bucket the purge writes expired audit rows to BEFORE deleting them. Must
# carry an R2 bucket lock rule, and must NOT be S3_BUCKET — a lock rule there
# would make recordings and activity photos undeletable too. Credentials and
# endpoint are shared with S3_* (same R2 account).
#
# Rows are pseudonymised on the way in: actor_email, ip_address and user_agent
# are dropped, and personal-data keys inside old_values/new_values are redacted,
# so an immutable copy does not block a GDPR art. 17 erasure request.
#
# Left empty, the purge REFUSES to delete anything (a dry run still reports).
AUDIT_ARCHIVE_BUCKET=eventclick-audit-archive
# Set true only to deliberately destroy expired audit rows with no archived
# copy. Separate from an empty bucket name on purpose: losing the backlog should
# be a decision, not a missing value.
AUDIT_ARCHIVE_DISABLED=false
