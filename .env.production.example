# ─────────────────────────────────────────────────────────────────────────────
# Eventclick — Production Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
#
# HOW IT WORKS:
#   .env is AUTO-GENERATED from AWS SSM Parameter Store during deployment.
#   deploy.sh calls fetch-secrets.sh which pulls all params under
#   /eventclick/prod/* and writes them to .env on the EC2 instance.
#
# TO UPDATE A VALUE:
#   aws ssm put-parameter --name "/eventclick/prod/VARIABLE_NAME" \
#     --value "new_value" --type SecureString --overwrite --region ap-south-1
#
# TO ADD A NEW VARIABLE:
#   aws ssm put-parameter --name "/eventclick/prod/NEW_VARIABLE" \
#     --value "value" --type String --region ap-south-1
#
# BUILD-TIME VARIABLES (VITE_*):
#   VITE_* variables are NOT in SSM — they are set in GitHub Secrets
#   and baked into the React build during Docker image creation.
#   Update them at: GitHub → Settings → Secrets → Actions
#
# THIS FILE IS A REFERENCE ONLY — do NOT manually create .env on EC2.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ───────────────────────────────────────
DB_USER=eventclick_prod
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=eventclick_db
AUTH_DB_PASSWORD=ADD_TO_SSM
APP_DB_PASSWORD=ADD_TO_SSM
DATABASE_URL=postgresql://eventclick_prod:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/eventclick_db
APP_DATABASE_URL: postgresql://app_user_login:${APPDBPASSWORD}@postgres:5432/${DB_NAME}
AUTH_DATABASE_URL: postgresql://auth_svc_role:${AUTHDBPASSWORD}@auth:5432/${DB_NAME}


# ─── Redis ──────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD_HERE@redis:6379

# ─── Server ─────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_DIFFERENT
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Domain & CORS ──────────────────────────────────
# CORS_ORIGIN supports comma-separated origins for multiple domains
APP_URL=https://app.eventclick.live
CORS_ORIGIN=https://app.eventclick.live,https://www.eventclick.live,https://eventclick.live
COOKIE_DOMAIN=.eventclick.live
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── Client (BUILD-TIME — set in GitHub Secrets, NOT SSM) ───────────────
# VITE_API_URL should be "" (empty) so the frontend uses relative /api/v1
# This avoids CORS issues since all API calls become same-origin through Nginx proxy.
# VITE_API_URL=""
# VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
# VITE_GOOGLE_CLIENT_ID=your-google-client-id

# ─── Email (Resend) ─────────────────────────────────
RESEND_API_KEY=re_CHANGE_ME_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=noreply@eventclick.live

# ─── Google OAuth ────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── LiveKit Cloud (free tier) ──────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# ─── Cloudflare R2 Storage ──────────────────────────
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://pub-YOUR_HASH.r2.dev
S3_REGION=auto
S3_BUCKET=eventclick-recordings
S3_ACCESS_KEY=YOUR_R2_ACCESS_KEY_ID
S3_SECRET_KEY=YOUR_R2_SECRET_ACCESS_KEY
S3_FORCE_PATH_STYLE=true

# ─── SQS Email Queue ────────────────────────────────
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/YOUR_ACCOUNT_ID/eventclick-email-queue

# ─── Attendance ─────────────────────────────────────
ATTENDANCE_WINDOW_BEFORE_MINUTES=15
ATTENDANCE_WINDOW_AFTER_MINUTES=30
BCRYPT_ROUNDS=12

# ─── Hardcoded (internal Docker network — NOT in SSM) ────────
# These are auto-appended by fetch-secrets.sh:
# GOTENBERG_URL=http://gotenberg:3000
# NODE_ENV=production
