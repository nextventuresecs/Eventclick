# ─────────────────────────────────────────────────────────────────────────────
# Eventclick / Eventclick — Production Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file to .env in the project root on your production server
#   2. Replace ALL placeholder values with real credentials
#   3. Generate secrets with: openssl rand -base64 48
#   4. NEVER commit .env to git — it is in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ─── General ────────────────────────────────────────
NODE_ENV=production
IMAGE_TAG=latest

# ─── Database ───────────────────────────────────────
DB_USER=eventclick_prod
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_NAME=eventclick_db
DATABASE_URL=postgresql://eventclick_prod:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/eventclick_db

# ─── Redis ──────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD_HERE@redis:6379

# ─── Server ─────────────────────────────────────────
API_PORT=4000
PORT=4000
LOG_LEVEL=info

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_DIFFERENT
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Domain & CORS ──────────────────────────────────
# Replace with your actual domain
APP_URL=https://app.yourdomain.com
CORS_ORIGIN=https://app.yourdomain.com
COOKIE_DOMAIN=.yourdomain.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── Client ─────────────────────────────────────────
CLIENT_PORT=80
CLIENT_SSL_PORT=443
VITE_API_URL=https://api.yourdomain.com/api/v1
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# ─── Email (Resend) ─────────────────────────────────
RESEND_API_KEY=re_CHANGE_ME_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── Google OAuth ────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ─── LiveKit Cloud (free tier) ──────────────────────
# Sign up at https://cloud.livekit.io
# Create a project → Get API Key & Secret from Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# ─── Cloudflare R2 Storage ──────────────────────────
# Cloudflare Dashboard → R2 → Create Bucket → Manage R2 API Tokens
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://pub-YOUR_HASH.r2.dev
S3_REGION=auto
S3_BUCKET=eventclick-recordings
S3_ACCESS_KEY=YOUR_R2_ACCESS_KEY_ID
S3_SECRET_KEY=YOUR_R2_SECRET_ACCESS_KEY
S3_FORCE_PATH_STYLE=false

# ─── Gotenberg (internal — no change needed) ────────
GOTENBERG_URL=http://gotenberg:3000

# ─── Attendance ─────────────────────────────────────
ATTENDANCE_WINDOW_BEFORE_MINUTES=15
ATTENDANCE_WINDOW_AFTER_MINUTES=30
BCRYPT_ROUNDS=12
